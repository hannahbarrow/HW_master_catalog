library(gsheet)
url <- 'https://docs.google.com/spreadsheets/d/17uB40b7daEa9GXjoSHupQF8jkvBeEIePT7pBPUPChkE/edit?usp=sharing'
firsl_2026 <- gsheet2tbl(url)
firs_land_2026 <- firsl_2026 %>%
select(YEAR, MONTH, DAY, ID, NAME)
firs_land_2026$DATE <- paste0(firs_land_2026$YEAR, "-", firs_land_2026$MONTH, "-", firs_land_2026$DAY)
M <- str_pad(firs_land_2026$MONTH, width = 2, side = "left", pad = "0")
D <- str_pad(firs_land_2026$DAY, width = 2, side = "left", pad = "0")
firs_land_2026$DATE <- paste0(firs_land_2026$YEAR, "-", M, "-", D)
fl_2026 <- firs_land_2026 %>%
select(DATE, ID)
fl_2026 %>% pull(ID) %>% unique
# 118 whales total this season as of 2026-8-10
# 128 whales as of 2026-08-16
per_day_land <- fl_2026 %>%
group_by(DATE) %>%
summarise(unique_ids = n_distinct(ID))
